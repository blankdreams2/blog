---
import Link from '@/components/shared/Link.astro'
import type { CTFTableEntry } from '@/data/ctf-table'
import { Icon } from 'astro-icon/components'

interface Props {
  entries: CTFTableEntry[]
}

const { entries } = Astro.props

function getRankingTier(ranking: string): '1st' | '2nd' | 'top10' | 'rest' {
  const r = ranking.trim().toLowerCase()
  if (r.startsWith('1st')) return '1st'
  if (r.startsWith('2nd')) return '2nd'
  const numMatch = r.match(/^(\d+)(?:st|nd|rd|th)/)
  if (numMatch) {
    const n = parseInt(numMatch[1]!, 10)
    if (n >= 3 && n <= 10) return 'top10'
  }
  return 'rest'
}

const RANKING_CLASSES: Record<'1st' | '2nd' | 'top10' | 'rest', string> = {
  '1st': 'text-amber-500 font-medium',
  '2nd': 'text-slate-400 font-medium',
  top10: 'text-amber-700 font-medium',
  rest: 'text-muted-foreground',
}

function hasOpenWriteup(value: string): boolean {
  const v = value.trim().toLowerCase()
  return v === 'ye' || v === 'yes'
}
---

<div class='overflow-x-auto rounded-xl border'>
  <table class='w-full min-w-[600px] border-collapse text-sm'>
    <thead>
      <tr class='bg-muted/50 border-b'>
        <th class='text-muted-foreground px-4 py-3 text-left font-medium tracking-wider uppercase'
          >Name</th
        >
        <th class='text-muted-foreground px-4 py-3 text-left font-medium tracking-wider uppercase'
          >Ranking</th
        >
        <th class='text-muted-foreground px-4 py-3 text-left font-medium tracking-wider uppercase'
          >Open Writeups</th
        >
        <th class='text-muted-foreground px-4 py-3 text-left font-medium tracking-wider uppercase'
          >Date</th
        >
        <th class='text-muted-foreground px-4 py-3 text-left font-medium tracking-wider uppercase'
          >Comment</th
        >
      </tr>
    </thead>
    <tbody>
      {
        entries.map((entry) => (
          <tr class='hover:bg-muted/30 border-b transition-colors last:border-b-0'>
            <td class='px-4 py-3'>
              {entry.postId ? (
                <Link
                  href={`/blog/${entry.postId}`}
                  class='text-primary hover:text-primary/80 inline-flex items-center gap-1 font-medium underline-offset-4 hover:underline'
                >
                  {entry.name}
                  <Icon name='lucide:arrow-up-right' class='size-3 shrink-0' />
                </Link>
              ) : (
                <span class='text-foreground'>{entry.name}</span>
              )}
            </td>
            <td class={`px-4 py-3 ${RANKING_CLASSES[getRankingTier(entry.ranking)]}`}>
              {entry.ranking}
            </td>
            <td class={`px-4 py-3 ${hasOpenWriteup(entry.openWriteups) ? 'font-semibold text-foreground' : 'text-muted-foreground'}`}>
              {entry.openWriteups}
            </td>
            <td class='text-muted-foreground px-4 py-3 tabular-nums'>{entry.date}</td>
            <td class='text-muted-foreground px-4 py-3 text-sm'>{entry.comment ?? '—'}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
