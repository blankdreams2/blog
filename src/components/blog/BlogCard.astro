---
import Link from '@/components/shared/Link.astro'
import { Badge } from '@/components/ui/badge'
import { getSubpostCount, getSubpostsForParent, isSubpost } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

/** Inline CTF logo data URL — always renders, no external request */
const CTF_LOGO_DATA_URL =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 80'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0%25' y1='0%25' x2='100%25' y2='100%25'%3E%3Cstop offset='0%25' stop-color='%230f172a'/%3E%3Cstop offset='50%25' stop-color='%231e293b'/%3E%3Cstop offset='100%25' stop-color='%230f172a'/%3E%3C/linearGradient%3E%3Cfilter id='gl'%3E%3CfeDropShadow dx='0' dy='0' stdDeviation='1' flood-color='%23e94560' flood-opacity='0.5'/%3E%3C/filter%3E%3C/defs%3E%3Crect width='120' height='80' rx='6' fill='url(%23g)' stroke='%23334155' stroke-width='1'/%3E%3Cpath d='M22 22 L42 40 L22 58 Z' fill='%23e94560' filter='url(%23gl)'/%3E%3Crect x='48' y='26' width='52' height='5' rx='2.5' fill='%23e94560'/%3E%3Crect x='48' y='36' width='42' height='5' rx='2.5' fill='%23f87171' opacity='0.9'/%3E%3Crect x='48' y='46' width='48' height='5' rx='2.5' fill='%23e94560' opacity='0.85'/%3E%3Ctext x='60' y='68' font-family='system-ui,sans-serif' font-size='10' font-weight='bold' fill='%23e94560'%3ECTF%3C/text%3E%3C/svg%3E"

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
// const formattedDate = formatDate(entry.data.date)
// const readTime = await getCombinedReadingTime(entry.id)
// const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry?.id) ? await getSubpostCount(entry?.id) : 0
const subposts =
  subpostCount > 0 && !isSubpost(entry?.id) ? await getSubpostsForParent(entry?.id) : []
---

<div class='hover:bg-muted/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out'>
  <Link href={`/${entry.collection}/${entry.id}`} class='flex flex-col gap-4 sm:flex-row'>
    {
      (() => {
        const img = entry.data.image as unknown
        if (!img) return null
        const isCtfLogo =
          (typeof img === 'string' && img.includes('ctf_flag_logo')) ||
          (typeof img === 'object' && img !== null && JSON.stringify(img).includes('ctf_flag_logo'))
        if (isCtfLogo) {
          return (
            <div class='bg-muted/50 aspect-4/3 w-full shrink-0 overflow-hidden rounded-lg sm:w-40 sm:min-w-40'>
              <img src={CTF_LOGO_DATA_URL} alt={entry.data.title} class='size-full object-cover' />
            </div>
          )
        }
        if (typeof img === 'string') {
          const src = img.startsWith('/public') ? img.slice(7) : img
          return (
            <div class='bg-muted/50 aspect-4/3 w-full shrink-0 overflow-hidden rounded-lg sm:w-40 sm:min-w-40'>
              <img src={src} alt={entry.data.title} class='size-full object-cover' />
            </div>
          )
        }
        return (
          <div class='bg-muted/50 aspect-4/3 w-full shrink-0 overflow-hidden rounded-lg sm:w-40 sm:min-w-40'>
            <Image
              src={img as import('astro').ImageMetadata}
              alt={entry.data.title}
              width={1200}
              height={630}
              class='size-full object-cover'
            />
          </div>
        )
      })()
    }

    <div class='grow'>
      <h3 class='mb-1 text-lg font-medium'>{entry.data.title}</h3>
      <p class='text-muted-foreground mb-2 text-sm'>{entry.data.description}</p>

      {
        entry.data.tags && (
          <div class='flex flex-wrap gap-2'>
            {entry.data.tags.map((tag) => (
              <Badge variant='muted' className='flex items-center gap-x-1'>
                <Icon name='lucide:hash' class='size-3' />
                {tag}
              </Badge>
            ))}
          </div>
        )
      }
    </div>
  </Link>

  {
    subposts.length > 0 && (
      <div class='mt-3 border-t pt-3'>
        <div class='text-muted-foreground mb-2 text-xs'>Subposts</div>
        <ul class='list-inside list-disc space-y-1 text-sm'>
          {subposts.slice(0, 6).map((sp) => (
            <li>
              <Link
                href={`/${sp.collection}/${sp.id}`}
                class='hover:text-foreground text-muted-foreground underline-offset-4 hover:underline'
              >
                {sp.data.title}
              </Link>
            </li>
          ))}
          {subposts.length > 6 && (
            <li>
              <Link
                href={`/${entry.collection}/${entry.id}`}
                class='hover:text-foreground text-muted-foreground underline-offset-4 hover:underline'
              >
                View all →
              </Link>
            </li>
          )}
        </ul>
      </div>
    )
  }
</div>
